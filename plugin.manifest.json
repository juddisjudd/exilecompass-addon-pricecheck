{
  "schemaVersion": "1.0",
  "id": "dev.juddisjudd.pricecheck-addon",
  "name": "Price Check",
  "description": "Price check PoE2 items against the official trade API: paste an item, pick your filters, see what it sells for.",
  "author": "Judd",
  "homepage": "https://github.com/juddisjudd/exilecompass-addon-pricecheck",
  "version": "0.2.0",
  "kind": "addon",
  "entry": {
    "panel": "./dist/panel.js",
    "data": "./data/default.json"
  },
  "compatibility": {
    "app": ">=1.5.0",
    "pluginApi": "^1.1.0"
  },
  "permissions": [
    "storage.read",
    "storage.write",
    "network.request:pathofexile.com",
    "network.fetch:web.poecdn.com",
    "shell.open:pathofexile.com",
    "ui.panel"
  ],
  "contributions": {
    "data.providers": [],
    "view.panels": [
      {
        "id": "pricecheck",
        "title": "Price Check",
        "icon": "panel",
        "pinDefault": true
      }
    ],
    "settings.sections": [],
    "actions.commands": []
  }
}
